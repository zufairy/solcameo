# SERVER ONLY. Do not put keys or RPC URLs containing keys in NEXT_PUBLIC_* vars.
X402_ENABLED=true
# Devnet settlement for development; Solami market data is always live MAINNET.
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_FACILITATOR_URL=https://x402.org/facilitator
# A real recipient wallet you control; no placeholder is accepted at runtime.
X402_PAY_TO=
# Canonical origin of THIS app. Use https in production.
X402_RESOURCE_ORIGIN=http://127.0.0.1:3000
# Solami API key with DataApi permission (RPC keys do not replace this).
SOLAMI_API_KEY=
# Optional for mainnet buyer signing; REQUIRED for mainnet receipt reconciliation.
# Copy the authenticated RPC URL from Solami's dashboard.
SOLAMI_RPC_URL=
# Optional for a facilitator using static Bearer authentication.
# CDP uses per-request JWT authentication and cannot use a static CDP API key here.
X402_FACILITATOR_BEARER_TOKEN=
# Existing app setup also requires:
# NEXT_PUBLIC_CONVEX_URL=...
# INTERNAL_CRON_SECRET=... (the same secret on Next and Convex)
# WALLET_ENCRYPTION_KEY=... (64 hex characters, server only)
# KIE_API_KEY=... (existing reasoning provider)
