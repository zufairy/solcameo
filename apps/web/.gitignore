# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# local HTTPS dev certs (next dev --experimental-https / mkcert)
/certificates

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.sample
!.env.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local yt-dlp binary (installed at runtime, not committed)
bin/yt-dlp

# Playwright artifacts
/test-results/
/playwright-report/

# JEV scorer venv (local python for scripts/jev/jev_score.py)
.venv-jev/

# Disposable x402 demo authorization (contains a signed payment).
x402-demo-payment.json
