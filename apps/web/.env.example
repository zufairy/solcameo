# ── Client (Next.js) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
# Server-to-server origin Convex uses to call back into this app. Leave EMPTY on
# Railway (auto-detected from RAILWAY_PUBLIC_DOMAIN). Set it — in BOTH the Railway
# service env and the CONVEX deployment env — only to force a specific origin.
# Must be an origin whose TLS cert is valid for STRICT clients (Convex fetch is
# Rust/BoringSSL): the *.up.railway.app host always is, a custom domain is only
# valid while its Railway cert is issued. See convex/lib/appFetch.ts.
INTERNAL_APP_URL=
NEXT_PUBLIC_HELIUS_API_KEY=
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_VELLO_ESCROW_PROGRAM_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# On-ramp (buy USDC with fiat) is native to Privy — no client env var. Enable a
# funding provider (Coinbase Onramp / MoonPay) + USDC-on-Solana in the Privy
# Dashboard; the app gates the Add-funds flow to mainnet automatically.

# ── Convex deployment env (set via `npx convex env set`, NOT here) ────────────
# Google login via Supabase (shared jobtepi project) — see docs/AUTH_SETUP.md
#   SUPABASE_URL          same as NEXT_PUBLIC_SUPABASE_URL (server-side token verify)
#   SUPABASE_ANON_KEY     same as NEXT_PUBLIC_SUPABASE_ANON_KEY
#   ADMIN_SEED_EMAILS     comma-separated emails auto-promoted to admin
#   RESEND_API_KEY        Resend API key — sends the new-user welcome email (convex/email.ts).
#                          Unset = welcome emails silently skipped, signup still works.
#   RESEND_FROM_EMAIL     optional, defaults to "Vello <welcome@vello.gg>". Needs a
#                          domain verified in Resend (DNS records) to actually deliver.

# ── Other server keys ────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=
KIE_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPLOAD_POST_API_KEY=
UPLOAD_POST_USERNAME=
ORACLE_WEBHOOK_SECRET=
# Path to the yt-dlp binary for social-URL (YouTube/TikTok/IG) clip ingestion.
# Defaults to `yt-dlp` on PATH; social URLs degrade with a helpful message if absent.
YTDLP_PATH=

# ── v2 on-chain campaign-treasury rail (oracle + permissionless crank) ─────────
# These GATE the on-chain (onchainVersion>=2) campaign-payout rail. If unset, the
# rail degrades SILENTLY to the legacy off-chain path — v2 campaigns simply won't
# settle/claim on-chain. Set them only once the escrow program is deployed AND
# init_platform_config has run (see docs/campaign-treasury/03-INTEGRATION-HANDOFF.md).
#
# Shared keeper/webhook secret (these crons + internal mutations authenticate with it).
INTERNAL_CRON_SECRET=
# Escrow program id (also a NEXT_PUBLIC_* above — keep them identical).
NEXT_PUBLIC_VELLO_ESCROW_PROGRAM_ID=
# Signs record_performance / reject_clip. MUST equal PlatformConfig.oracle on-chain.
# Format: base64-encoded 64-byte ed25519 secret key. The wallet needs SOL (it is the
# rent payer for each ClaimRecord + pays tx fees).
VELLO_ORACLE_SECRET=
# Signs claim_payout (the permissionless crank). Format: base64-encoded 64-byte
# ed25519 secret key. Needs SOL (gas + agent-ATA rent). MAY equal VELLO_ORACLE_SECRET.
VELLO_CRANK_SECRET=

# Higgsfield (Character builder: Soul / Soul 2). Format: <key-id>:<key-secret>. Server-side only.
HF_CREDENTIALS=

# Direct X OAuth (server-only; use a confidential Web App / Automated App)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must exactly match a callback registered in X Developer Console
X_REDIRECT_URI=https://YOUR_PRODUCTION_DOMAIN/api/social/x/callback
# Stable base64-encoded 32-byte key; generate with openssl rand -base64 32
X_TOKEN_ENCRYPTION_KEY=

# ── Meteora coin launches ────────────────────────────────────────────────────
# RPC must match NEXT_PUBLIC_SOLANA_NETWORK; genesis is verified before devnet writes.
SOLCAMEO_DBC_RPC_URL=https://api.devnet.solana.com
# Only needed for a deliberate mainnet launch; devnet needs no mainnet enable flag.
SOLCAMEO_DBC_LIVE_ENABLED=false
# INTERNAL_CRON_SECRET must match the Convex deployment. R2 image storage stores public coin metadata.

# Optional second public market source for the local RPC leaderboard.
# Useful when local development and production have separate Convex databases.
# Leave unset in production; its normal NEXT_PUBLIC_CONVEX_URL is sufficient.
SOLCAMEO_LEADERBOARD_CONVEX_URL=

# Optional: enables full GIPHY search in callout attachments (public integration key).
NEXT_PUBLIC_GIPHY_API_KEY=

# SOLCAMEO platform token (leave unset until the token is launched; features stay inert)
SOLCAMEO_TOKEN_MINT=
SOLCAMEO_TEAM_WALLET=
SOLCAMEO_TREASURY_WALLET=
SOLCAMEO_REWARDS_WALLET=
# Keypair that holds bought-back tokens and signs burns (JSON array or base58). Server only.
SOLCAMEO_TREASURY_SECRET=
# Burns are a dry run unless this is "true" AND the request sets execute:true
SOLCAMEO_EPOCH_EXECUTE=false
