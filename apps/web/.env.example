# Solcameo production environment (Railway). Names only: never commit values.
# NEXT_PUBLIC_* values are baked in at build time, so changing one needs a redeploy.
# Convex has its OWN environment (`npx convex env set`); INTERNAL_CRON_SECRET must be identical in both.
# Not set on purpose (the Dockerfile provides them): PORT, HOSTNAME, YTDLP_PATH, YTDLP_POT_PROVIDER_URL.

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://solcameo.com
NEXT_PUBLIC_SITE_URL=https://solcameo.com
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Leave empty on Railway (auto-detected). See convex/lib/appFetch.ts.
INTERNAL_APP_URL=
# Shared by the Next app, Convex and the keepers. 32+ characters.
INTERNAL_CRON_SECRET=

# ── Auth ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Only for a separate local Privy client. Leave unset in production.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
SIWS_SESSION_SECRET=
PASSWORD_AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Encrypts every agent wallet key at rest. Never rotate without migrating the stored keys.
WALLET_ENCRYPTION_KEY=

# ── Solana: mainnet ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# One key drives every RPC URL (mainnet, via NEXT_PUBLIC_SOLANA_NETWORK). Do not also set an RPC URL by hand.
NEXT_PUBLIC_HELIUS_API_KEY=
# Optional override; if set it must be the canonical mainnet USDC mint.
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ── Wallets: where money goes ────────────────────────────────────────────────
# Generation payments (Higgsfield, Kie and the other providers you top up by hand). Agents and studio users pay
# USDC here on-chain before anything is generated. Defaults to this address if unset.
SOLCAMEO_GENERATION_COLLECTION_WALLET=EhXTsbTMTgkGhBdUGAWx5JL78Jmu1dZgDCVUFWJp3pSa
# Platform treasury: mint fees, platform revenue, launch fees. Address only; keep these two identical.
NEXT_PUBLIC_JOBTEPI_TREASURY_WALLET=
SOLCAMEO_PLATFORM_WALLET=
# Pays the SOL network fee for every agent payout and settlement so agent wallets need no SOL.
# A FULL 64-byte keypair (base64, base58 or JSON array), NOT an address, and it must hold SOL (0.05+).
PLATFORM_FEE_PAYER_SECRET=
# Meteora coin launches. The key's own wallet becomes the fee claimer and pays launch gas, so it needs SOL.
# Do not also set SOLCAMEO_DBC_TREASURY_WALLET: the address is derived from this key.
SOLCAMEO_DBC_TREASURY_SECRET=
SOLCAMEO_DBC_LIVE_ENABLED=true
# Optional (defaults to the Helius URL above). Must be a MAINNET endpoint.
SOLCAMEO_DBC_RPC_URL=
# Agent vault program is not deployed on mainnet; agents use custodial wallets.
SOLCAMEO_AGENT_VAULT_ENABLED=false
# Generation fees. Charges of at least this many dollars (videos, images) are paid on-chain BEFORE the work starts.
AGENT_PAY_FIRST_MIN_USDC=0.02
# Smaller charges (text, captions) pile up on the agent's tab and are paid in one transfer once it reaches this.
AGENT_BATCH_SETTLE_USDC=0.25
# Backstop for tabs nothing else swept; 0 = pay anything owed on the next sweep.
VELLO_SETTLE_THRESHOLD_USDC=0
# Mints the agent NFT. Only needed while /api/nft/mint is in use.
NFT_MINT_AUTHORITY_SECRET=

# ── Generation providers ─────────────────────────────────────────────────────
# Higgsfield: <key-id>:<key-secret>
HF_CREDENTIALS=
KIE_API_KEY=
KIE_CHAT_MODEL=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
FIRECRAWL_API_KEY=
IMGBB_API_KEY=
GOOGLE_DRIVE_API_KEY=
# Fixed service charge per automatic flywheel video, in lamports. Required before automatic mainnet video generation.
SOLCAMEO_VIDEO_COST_LAMPORTS=

# ── Storage ──────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
TRENDING_AUDIO_BASE_URL=

# ── Social posting ───────────────────────────────────────────────────────────
UPLOAD_POST_API_KEY=
UPLOAD_POST_USERNAME=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://solcameo.com/api/social/x/callback
# openssl rand -base64 32
X_TOKEN_ENCRYPTION_KEY=
# Optional: live impressions via the X API v2.
X_BEARER_TOKEN=

# ── Clip downloads ───────────────────────────────────────────────────────────
CLIP_MAX_DOWNLOAD_BYTES=5368709120
YTDLP_PROXY=
# Optional extras used by the AI-video scoring tool.
TYPESAFE_API_KEY=

# ── Campaign escrow (optional, off until the escrow program exists on MAINNET) ───
# The program id in the old environment only exists on devnet. Leave these unset on mainnet until you deploy it,
# then set the id, VELLO_ORACLE_SECRET and VELLO_CRANK_SECRET together (each wallet needs SOL).
# NEXT_PUBLIC_VELLO_ESCROW_PROGRAM_ID=
# VELLO_ORACLE_SECRET=
# VELLO_CRANK_SECRET=

# ── SOLCAMEO platform token (leave unset until the token is launched) ────────
SOLCAMEO_TOKEN_MINT=
SOLCAMEO_TEAM_WALLET=
SOLCAMEO_TREASURY_WALLET=
SOLCAMEO_REWARDS_WALLET=
SOLCAMEO_TREASURY_SECRET=
SOLCAMEO_EPOCH_EXECUTE=false
SOLCAMEO_PLATFORM_LAUNCH_WALLET=

# ── Swaps ────────────────────────────────────────────────────────────────────
# Jupiter Swap V2 key (free at portal.jup.ag). An agent that holds SOL but not enough USDC has the shortfall swapped
# to USDC automatically before a job is charged. Without a key the free keyless router is used (slower, rate limited).
JUPITER_API_KEY=
# Largest single SOL to USDC top-up, in dollars.
AGENT_SWAP_MAX_USD=50

# ── Optional ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GIPHY_API_KEY=
SOLCAMEO_LEADERBOARD_CONVEX_URL=
ORACLE_WEBHOOK_SECRET=

# Platform fee claim: 40% operations and 30% treasury shares are sent here when fees are claimed.
SOLCAMEO_OPS_WALLET=
